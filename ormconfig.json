{
  "type": "postgres",
  "host": "${DB_HOST}",
  "port": "${DB_PORT}",
  "username": "${DB_USERNAME}",
  "password": "${DB_PASSWORD}",
  "database": "${DB_DATABASE}",
  "synchronize": false,
  "logging": false,
  "migrations": ["./src/database/migrations/*.ts"],
  "entities": ["./src/entities/*.ts"],
  "cli": {
    "migrationsDir": "./src/database/migrations",
    "entitiesDir": "./src/entities"
  }
}
